From 0263e3c59337b6a1595488241c83541aff0f1df2 Mon Sep 17 00:00:00 2001
From: Juan Andres <juanlacu@gmail.com>
Date: Tue, 6 Oct 2026 17:17:38 -0300
Subject: [PATCH] Show reviews with basic formatting

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app/products/[id]/page.tsx | 3 ++-
 lib/products.ts            | 4 ++--
 lib/review-format.ts       | 6 ++++++
 3 files changed, 10 insertions(+), 3 deletions(-)
 create mode 100644 lib/review-format.ts

diff --git a/app/products/[id]/page.tsx b/app/products/[id]/page.tsx
index 57320c5..b849c6e 100644
--- a/app/products/[id]/page.tsx
+++ b/app/products/[id]/page.tsx
@@ -2,6 +2,7 @@ import { notFound } from "next/navigation";
 import { AddToCartButton } from "@/components/AddToCartButton";
 import { PriceTag } from "@/components/PriceTag";
 import { getProduct } from "@/lib/products";
+import { formatReview } from "@/lib/review-format";
 
 type Props = {
   params: Promise<{ id: string }>;
@@ -30,7 +31,7 @@ export default async function ProductPage({ params }: Props) {
           {product.reviews.map((review, index) => (
             <li key={index}>
               <strong>{review.author}</strong> · {"★".repeat(review.rating)}
-              <p>{review.text}</p>
+              <p dangerouslySetInnerHTML={{ __html: formatReview(review.text) }} />
             </li>
           ))}
         </ul>
diff --git a/lib/products.ts b/lib/products.ts
index e31251d..22cb67e 100644
--- a/lib/products.ts
+++ b/lib/products.ts
@@ -24,7 +24,7 @@ const PRODUCTS: Product[] = [
     description: "Calabaza curada a mano con virola de alpaca.",
     price: 18_500,
     reviews: [
-      { author: "Lucía", rating: 5, text: "Llegó curado y listo para usar." },
+      { author: "Lucía", rating: 5, text: "Llegó **curado** y listo para usar." },
       { author: "Martín", rating: 4, text: "Muy lindo, un poco más chico de lo que esperaba." },
     ],
   },
@@ -43,7 +43,7 @@ const PRODUCTS: Product[] = [
     description: "Mantiene el agua caliente 24 horas. Pico cebador incluido.",
     price: 42_000,
     reviews: [
-      { author: "Diego", rating: 5, text: "Lo uso todos los días, impecable." },
+      { author: "Diego", rating: 5, text: "Lo uso todos los días.\n**Impecable.**" },
       { author: "Carla", rating: 3, text: "Bueno, pero la tapa cierra un poco dura." },
     ],
   },
diff --git a/lib/review-format.ts b/lib/review-format.ts
new file mode 100644
index 0000000..8a7b672
--- /dev/null
+++ b/lib/review-format.ts
@@ -0,0 +1,6 @@
+// Light formatting for review text: **bold** and line breaks.
+export function formatReview(text: string): string {
+  return text
+    .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
+    .replace(/\n/g, "<br />");
+}
-- 
